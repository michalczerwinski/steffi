<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="0.6.0" />
    <PackageReference Include="TUnit.Assertions" Version="0.6.0" />
    <PackageReference Include="TUnit.Engine" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steffi.Parsers\Steffi.Parsers.csproj" />
    <ProjectReference Include="..\Steffi.Models\Steffi.Models.csproj" />
    <ProjectReference Include="..\Steffi.Renderers\Steffi.Renderers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RenderingTests\*.input.stf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="RenderingTests\*.expected.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
