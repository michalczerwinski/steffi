#inlcude <azure-diagrams.stf>

//verbatim syntax
Graph cloud
{
    Node backendServer
    {
        label: "Backend Server";
        fontColor: red;
    }
    
    Node database
    {
        label: "Database";
    }

    Edge readsWrites
    {
        from: database;
        to: backendServer;
        label: "Reads/Writes";
    }
}

//Concise syntax
Graph cloud
{
    backendServer -readsWrites-> database
}


set backendServer 
{
    label: "Backend Server";
}

set database 
{
    label: "Database";
}

set readsWrites 
{
    label: "Reads/Writes";
}