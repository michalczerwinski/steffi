layout: Canvas;

Rectangle r1{x:10; y: 10; width:100;height:20;}
Rectangle r2{x:25; y: 35; width:100;height:20;}
Rectangle r3{x:50; y: 60; width:100;height:20;} 

Text { x:150; y:0; label: "Hello world!"; fontColor: "red";}

HorizontalStack 
{
	x: 10; y: 90;
	Rectangle{width:100;height:20;}
	Rectangle{width:100;height:20;}
	Rectangle{width:100;height:20;}

	VerticalStack 
	{
		Rectangle{width:100;height:20;}
		Rectangle{width:100;height:20;}
		Rectangle{width:100;height:20;}
		Text { label:"aaa"; }
		Canvas c 
		{
			Text { label: "in canvas"; x: 10; y: 0; fontSize:10; fontColor:blue;}
		}
	}
}