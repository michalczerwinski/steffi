			  Polyline { x: 10; y: 10; points: 1.2,0.5 50.5,13.0 100,0 0,0; fill: "blue"; stroke: "green"; }
			}
		}
		Circle { x:10; y:12; r:4;fill:black;}
		Circle { x:32; y:12; r:4;fill:black;}
	}
	Ellipse { rx: 50; ry:20; strokeWidth:2; fill:blue;}
	padding: 10;
	VerticalStack {
		Canvas {
			width: 200;
			Text {spans: "SteffiDocument:\n-Svg";fontSize: 12;fontColor: black;}
		}
		Canvas {
			Text {spans: "Shape:\n-Rectangle\n-Circle\n-Ellipse";fontSize: 12;fontColor: black;}
		}
		Circle { r:120;strokeWidth:13;stroke: green;fill:red;}
		padding:10;
	}

	Text {spans: "Alek robalek!\nJurek ogórek\nkiełbaska i sznurek\nTata łopata";fontSize: 25;fontColor: red;}
