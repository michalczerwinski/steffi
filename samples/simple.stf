Canvas {
	padding: 5;
	VerticalStack {
		stroke: black;
		x: 0;
		spacing: 0;
		Ellipse { rx: 25; ry:20; strokeWidth:2; fill:lightgray;}
		Ellipse { rx: 25; ry:25; strokeWidth:2; fill:lightgray;}
		Ellipse { rx: 25; ry:20; strokeWidth:2; fill:lightgray;}
	}
	Polyline { x: 7; y: 50; points: 0,0 20,40 40,0 0,0; fill: blue; stroke: green; }
	Circle { x:10; y:12; r:4;fill:black;}
	Circle { x:32; y:12; r:4;fill:black;}
}